// This is your Prisma schema file (Prisma v7 Standard)
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/**
 * 分類狀態枚舉
 */
enum CategoryStatus {
  ACTIVE
  INACTIVE
  DELETED
}

model User {
  id                String       @id @default(uuid())
  username          String       @unique
  passwordHash      String
  role              String       @default("CS_AGENT")
  lastUsedExtension String?
  records           TaskRecord[]
  createdAt         DateTime     @default(now())
}

model Category {
  id             String         @id @default(uuid())
  name           String         @unique
  status         CategoryStatus @default(ACTIVE)
  alertThreshold Int            @default(0)
  records        TaskRecord[]
  createdAt      DateTime       @default(now())
}

model TaskRecord {
  id                 String   @id @default(uuid())
  extension          String
  location           String
  categoryId         String
  problemDescription String?
  handling           String?
  createdAt          DateTime @default(now())
  creatorId          String
  isAnonymized       Boolean  @default(false)

  category Category @relation(fields: [categoryId], references: [id])
  creator  User     @relation(fields: [creatorId], references: [id])
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  action    String
  metadata  String 
  ipAddress String
  createdAt DateTime @default(now())
}
